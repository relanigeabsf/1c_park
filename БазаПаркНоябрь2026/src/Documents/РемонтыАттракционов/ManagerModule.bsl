Функция УдалитьЛидирующиеНуди(Номер)
	
	Результат = Номер;
	Пока СтрНачинаетсяС(Результат, "0") Цикл
		Результат = Сред(Результат, "2");
	КонецЦикла;
	
	Возврат Результат;
	
	
КонецФункции


